# Docker Compose 开发环境变量模板
# 复制为根目录 .env 后供 docker-compose.dev.yml 读取。
# 后端裸进程的变量模板见 backend/.env.example，不能用根目录 .env 代替。

# 外部容器的原生变量。仅用于本地 Compose，正式部署必须替换默认凭据。
POSTGRES_USER=omninest
POSTGRES_PASSWORD=omninest
RABBITMQ_DEFAULT_USER=omninest
RABBITMQ_DEFAULT_PASS=omninest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
RPC_SECRET=omninest

# 本地影视只读挂载。Compose 只负责将宿主机目录只读提供给 FFmpeg。
# 宿主机上的可信媒体根目录，也是 mountKey=media 的安全边界；不是每个用户的目录，也不会写入数据库。
# Compose 会把它只读挂载给 FFmpeg。相对路径以项目根目录为基准；Windows 其他磁盘可写 D:/Media。
# 不要填写单个影片路径、系统盘根目录或客户端电脑路径；修改后需要重启相关进程。
OMNINEST_LOCAL_MEDIA_ROOT=./.omninest/local-media
# ClamAV 容器资源边界和宿主机端口。
CLAMAV_HOST_PORT=3310
CLAMD_CONF_StreamMaxLength=2047M
CLAMD_CONF_MaxScanSize=2047M
CLAMD_CONF_MaxFileSize=2047M
CLAMD_CONF_MaxScanTime=1800000
CLAMD_CONF_ReadTimeout=1800

# Rclone RC 凭据仅用于开发环境，正式环境必须替换。
RCLONE_RC_USER=admin
RCLONE_RC_PASS=secret

# AI Sidecar 下载与 CPU 资源限制。
OMNINEST_AI_SIDECAR_SECRET=change-me-ai-sidecar-random-secret
AI_MODEL_DOWNLOAD_TIMEOUT_SECONDS=30
AI_CPU_THREADS=2
